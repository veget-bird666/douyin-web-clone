# 复制为 .env 后填写真实值：cp .env.example .env

# 主域名（浏览器访问站点）
DOMAIN=xindudu.online

# 媒体子域名（视频直链，需添加 DNS A 记录指向服务器）
MEDIA_DOMAIN=media.xindudu.online

# MinIO 预签名 URL 使用的外网地址（与 MEDIA_DOMAIN 一致，HTTPS 上线后改为 https://）
MINIO_PUBLIC_ENDPOINT=http://media.xindudu.online

# MySQL
MYSQL_DATABASE=douyin_clone
MYSQL_PASSWORD=请设置强密码

# MinIO
MINIO_ACCESS_KEY=请设置访问密钥
MINIO_SECRET_KEY=请设置秘密密钥

# JWT（务必使用长随机字符串）
JWT_SECRET=请设置长随机字符串

# 邮箱（验证码登录）
MAIL_HOST=smtp.xindudu.online
MAIL_PORT=465
MAIL_USERNAME=xindudu
MAIL_PASSWORD=你的邮箱密码
MAIL_FROM_NAME=抖音精选
MAIL_FROM_ADDRESS=Douyin@xindudu.online
MAIL_SMTP_DOMAIN=xindudu.online
